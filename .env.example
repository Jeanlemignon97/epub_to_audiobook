# Copiez ce fichier vers .env et renseignez la clé du fournisseur choisi.
# Ne commitez jamais votre fichier .env.
OPENAI_API_KEY=

# Optionnel : uniquement pour Azure TTS.
MS_TTS_KEY=
MS_TTS_REGION=

# Emplacement persistant de la bibliothèque dans le conteneur.
AUDIOBOOK_DATA_DIR=/data

# Dossier de votre ordinateur où les M4B terminés seront exportés.
AUDIOBOOK_EXPORT_DIR=./audiobook_exports
